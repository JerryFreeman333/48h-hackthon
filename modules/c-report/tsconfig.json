{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "domain/**/*.ts",
    "ui/**/*.ts",
    "application/**/*.ts",
    "adapters/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
