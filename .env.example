# Shared providers are intentionally not configured.
DATABASE_URL=
AUTH_PROVIDER=
MODEL_PROVIDER=
MODEL_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_AGENT_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M2.7
# Optional absolute Python executable; defaults to project .venv then python.
RESEARCH_AGENT_PYTHON=
# Agent v2: deterministic public channel research, also requires RESEARCH_AGENT_ENABLED=true.
# No MiniMax key is needed for v2 acquisition and source-grounded explanations.
RESEARCH_AGENT_V2_ENABLED=false
RESEARCH_V2_SECONDS=150
RESEARCH_V2_MAX_REQUESTS=22
RESEARCH_V2_MAX_DOCUMENTS=12
RESEARCH_V2_MAX_BYTES=18000000
RESEARCH_V2_HTTP_TIMEOUT=10
RESEARCH_V2_FOLLOWUP_ROUNDS=2
RESEARCH_V2_CACHE_SECONDS=86400
