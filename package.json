{
  "name": "job-xray",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test packages/contracts/contracts.test.ts packages/runtime/runtime.test.ts modules/research-agent/v3.test.ts modules/research-agent/xmind/*.test.ts",
    "test:b": "tsx --test modules/b-research/service.test.ts",
    "test:a": "npm --prefix modules/a-profile test",
    "test:integration": "tsx --test packages/integration/*.test.ts app/reports/reports.test.ts",
    "typecheck": "tsc --noEmit",
    "test:c": "tsx --test modules/c-report/tests/*.test.ts",
    "test:agent": "tsx --test modules/research-agent/research.test.ts modules/research-agent/v2.test.ts modules/research-agent/v3.test.ts modules/research-agent/xmind/*.test.ts",
    "test:agent:python": "python -X utf8 -m unittest discover -s modules/research-agent -p test_v2*.py -v",
    "test:v3": "tsx --test modules/research-agent/v3.test.ts modules/research-agent/xmind/*.test.ts",
    "test:v3:python": "python -X utf8 -m unittest discover -s modules/research-agent -p test_v3*.py -v"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
